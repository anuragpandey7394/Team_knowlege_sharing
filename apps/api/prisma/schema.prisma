generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  READER
  REVIEWER
  EDITOR
  ADMIN
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(100)
  passwordHash String
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  sessions Session[]
  tokens AuthToken[]
  memberships Membership[]
  createdOrganizations Organization[]
  invitations Invitation[]
  createdPages Page[]
  editedDrafts PageDraft[]
  publishedVersions PageVersion[]
  auditEvents AuditEvent[]
  comments Comment[]
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  csrfHash String @db.VarChar(64)
  userId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  userId String @db.Uuid
  purpose TokenPurpose
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
}
model Organization {
  membershipRevision Int @default(0)
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  creatorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  creator User @relation(fields: [creatorId], references: [id])
  memberships Membership[]
  invitations Invitation[]
  spaces Space[]
  outboxEvents OutboxEvent[]
  auditEvents AuditEvent[]
}
model Membership {
  organizationId String @db.Uuid
  userId String @db.Uuid
  role Role
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
  @@index([userId])
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  email String @db.VarChar(254)
  role Role
  tokenHash String @unique @db.VarChar(64)
  inviterId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [inviterId], references: [id])
  @@index([organizationId, email])
}

model RateLimit {
  key String @id @db.VarChar(150)
  attempts Int @default(1)
  resetsAt DateTime @db.Timestamptz(3)
  @@index([resetsAt])
}

model Space {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name String @db.VarChar(100)
  description String @default("") @db.VarChar(1000)
  treeRevision Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id])
  pages Page[]
  @@unique([organizationId, id])
}
model Page {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  spaceId String @db.Uuid
  parentId String? @db.Uuid
  creatorId String @db.Uuid
  revision Int @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  publishedVersionId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  space Space @relation(fields: [organizationId, spaceId], references: [organizationId, id])
  creator User @relation(fields: [creatorId], references: [id])
  parent Page? @relation("PageTree", fields: [organizationId, spaceId, parentId], references: [organizationId, spaceId, id], onDelete: Restrict, onUpdate: Restrict)
  children Page[] @relation("PageTree")
  draft PageDraft?
  versions PageVersion[] @relation("PageVersions")
  comments Comment[]
  publishedVersion PageVersion? @relation("PublishedVersion", fields: [organizationId, id, publishedVersionId], references: [organizationId, pageId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, id])
  @@unique([organizationId, spaceId, id])
  @@index([organizationId, spaceId, parentId, createdAt, id])
}
model PageDraft {
  pageId String @id @db.Uuid
  organizationId String @db.Uuid
  title String @db.VarChar(200)
  body Json
  text String
  revision Int @default(0)
  updatedById String @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  page Page @relation(fields: [organizationId, pageId], references: [organizationId, id])
  updatedBy User @relation(fields: [updatedById], references: [id])
  @@unique([organizationId, pageId])
  @@index([organizationId])
}
model PageVersion {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  pageId String @db.Uuid
  number Int
  draftRevision Int
  parentId String? @db.Uuid
  spaceId String @db.Uuid
  idempotencyKey String @db.Uuid
  title String @db.VarChar(200)
  body Json
  text String
  publisherId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  page Page @relation("PageVersions", fields: [organizationId, pageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor Page[] @relation("PublishedVersion")
  comments Comment[]
  publisher User @relation(fields: [publisherId], references: [id])
  @@unique([organizationId, pageId, id])
  @@unique([organizationId, pageId, number])
  @@unique([organizationId, pageId, idempotencyKey])
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  sourceType String @db.VarChar(30)
  sourceId String @db.Uuid
  sourceVersionId String @db.Uuid
  kind String @db.VarChar(50)
  dedupeKey String @unique @db.VarChar(200)
  state String @default("PENDING") @db.VarChar(30)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId, state, createdAt])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorId String @db.Uuid
  action String @db.VarChar(60)
  resourceId String @db.Uuid
  requestId String @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([organizationId, createdAt])
}

model Comment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  pageId String @db.Uuid
  pageVersionId String @db.Uuid
  authorId String @db.Uuid
  revision Int @default(1)
  tombstonedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  page Page @relation(fields: [organizationId, pageId], references: [organizationId, id])
  pageVersion PageVersion @relation(fields: [organizationId, pageId, pageVersionId], references: [organizationId, pageId, id])
  author User @relation(fields: [authorId], references: [id])
  revisions CommentRevision[]
  @@unique([organizationId, id])
  @@index([organizationId, pageId, createdAt, id])
}
model CommentRevision {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  commentId String @db.Uuid
  number Int
  text String @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  comment Comment @relation(fields: [organizationId, commentId], references: [organizationId, id])
  @@unique([organizationId, commentId, number])
  @@unique([organizationId, commentId, id])
}
