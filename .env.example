NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Synthetic local defaults only. Never use these in hosted environments.
DATABASE_URL=postgresql://tka:tka_local_only@127.0.0.1:55432/tka_dev
TEST_DATABASE_URL=postgresql://tka:tka_local_only@127.0.0.1:55432/tka_test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
AI_PROVIDER=disabled
# Development-only CSRF key; replace with a unique random secret before hosting.
CSRF_SECRET=local-development-only-csrf-secret-change-before-hosting
AUTH_SESSION_DAYS=7
AUTH_RATE_LIMIT=10
AUTH_MAIL_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
AUTH_VERIFY_HOURS=24
AUTH_RESET_MINUTES=30
